# ---------- Lokale SQLite-Datenbank ----------
# Das ist vermutlich die Hauptursache eurer Merge-Probleme: Jede Instanz hat
# ihre eigenen Testdaten, die Binärdatei lässt sich nicht sinnvoll mergen.
backend/data/
**/data/*.db
**/data/*.db-wal
**/data/*.db-shm
*.sqlite
*.sqlite3

